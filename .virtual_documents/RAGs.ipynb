def test_rag_system(query: str, 
                   show_context: bool = True,
                   max_new_tokens: int = 500) -> str:

    print(f"\n{'='*50}")
    print(f"QUERY: {query}")
    print(f"{'='*50}")
    
    answer, context= ask(
        query=query,
        temperature=0.7,
        max_new_tokens = 400
    )
    print(f"\n")
    print(f"\nANSWER:\n{answer}\n")

    if show_context:
        print("="*100)
        print(f"context: \n{context}")
    
    return answer





