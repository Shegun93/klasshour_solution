def ask(query, temperature = 0.7, 
        max_new_tokens=400, 
        #min_new_tokens=200
       ):
    """
    Retrieve content i.e context from vector DB
    prompt format it for LLM
    Feed this prompt as input to LLM
    """
    vector = data_ingestion.embeddings.encode(query).tolist()
    results = index.query(vector=vector, top_k=5, include_metadata=True)
    context_chunks = [result.metadata.get("text") for result in results.matches]
    context = "\n".join(context_chunks)
    Prompt = f"""Answer the question based on the context below.".
    
    Question:{query}
    Context: {context}
    Answer:"""

    #Feed context as input to LLM

    inputs = tokenizer(Prompt, return_tensors="pt").to(model.device)
    outputs = model.generate(**inputs,
                             temperature = temperature,
                             max_new_tokens = max_new_tokens,
                            #min_new_tokens=min_new_tokens,
                            repetition_penalty=1.1)
    
    full_response = tokenizer.decode(outputs[0], skip_special_tokens=True)
    answer = full_response.replace(Prompt, "").strip()

    return answer, context


